# =========================
# Sales Engine - ENV CONFIG
# =========================

# 项目根路径
SALES_ENGINE_BASE_DIR=/home/admin/.openclaw/workspace/Sales_bi_dashboard_v1.0/sales-engine

# 输入目录：放 CRM 导出的录音 CSV
SALES_ENGINE_INPUT_DIR=/home/admin/.openclaw/workspace/Sales_bi_dashboard_v1.0/sales-engine/data/input

# 输出目录：生成标准化录音表
SALES_ENGINE_OUTPUT_DIR=/home/admin/.openclaw/workspace/Sales_bi_dashboard_v1.0/sales-engine/data/output

# 日志目录
SALES_ENGINE_LOG_DIR=/home/admin/.openclaw/workspace/Sales_bi_dashboard_v1.0/sales-engine/logs


# =========================
# 阿里云 ASR，后续转写用
# =========================

ALIYUN_DASHSCOPE_API_KEY=your_aliyun_api_key_here


# =========================
# MiniMax，后续文本分析用
# =========================

MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=m2.7-chat


# =========================
# 钉钉多维表，后续写表用
# =========================

DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_BITABLE_APP_TOKEN=
DINGTALK_RECORDING_LINK_TABLE_ID=
DINGTALK_RECORDING_ANALYSIS_TABLE_ID=
DINGTALK_SALES_POOL_TABLE_ID=


# =========================
# 运行控制
# =========================

BATCH_SIZE=5
DEBUG=true
